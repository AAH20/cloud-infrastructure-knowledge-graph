{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2zsoc.com/schemas/cloudgraph-snapshot-v1.json",
  "title": "CloudGraph Snapshot",
  "type": "object",
  "required": ["snapshot_id", "nodes", "edges"],
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1},
    "graph_freshness_seconds": {"type": "number", "minimum": 0},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "source", "observed_at", "attributes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"},
          "attributes": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "relation", "evidence", "observed_at"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "relation": {"type": "string"},
          "evidence": {"type": "string"},
          "observed_at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
